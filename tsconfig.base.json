{
  "compilerOptions": {
    "target": "es2016",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "typeRoots": ["node_modules/@types", "src/types"],
    "lib": ["ESNext"],
    "declaration": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib", "src/__tests__", "src/__mocks__"]
}
